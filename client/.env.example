# Cổng dev UI (mặc định 5174). Đặt số khác nếu trùng cổng trên máy (vd. 3002).
VITE_DEV_PORT=5174

# Backend API (Express). Dev: /api qua Vite proxy → :3000.
# Vercel: mặc định /api (Serverless client/api). Chỉ set nếu API host riêng:
# VITE_API_BASE_URL=https://your-api.example.com/api
#
# Vercel → Project → Environment Variables (Production + Preview):
#   SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...
# (hoặc VITE_SUPABASE_* — server đọc cả hai tên)

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
